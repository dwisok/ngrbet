# Deployer wallet (never commit the real .env)
PRIVATE_KEY=0x...
# Backend signer key: authorises claims. Can be a different wallet from the deployer.
SIGNER_PRIVATE_KEY=0x...
# Robinhood Chain RPCs
ROBINHOOD_RPC=https://rpc.mainnet.chain.robinhood.com
ROBINHOOD_TESTNET_RPC=https://rpc.testnet.chain.robinhood.com

# Deployment parameters
THRESHOLD_POINTS=10000        # min points to claim
POINTS_FOR_MAX=1000000        # points at which the payout reaches MAX_PAYOUT_ETH
MIN_PAYOUT_ETH=0.001
MAX_PAYOUT_ETH=0.1
COOLDOWN_SECONDS=86400        # one claim per wallet per 24h
FUND_ETH=0                    # optional: ETH to send to the contract right after deploy

# Signer service
CONTRACT_ADDRESS=0x...
RPC_URL=https://rpc.testnet.chain.robinhood.com
CHAIN_ID=46630
API_KEY=change-me             # required on POST /points/add
PORT=8787
